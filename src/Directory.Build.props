<Project>
  <PropertyGroup>
    <Authors>Pendragon Development</Authors>
    <Company>Pendragon Development</Company>
    <Product>Huddle</Product>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright 2026 Pendragon Development</Copyright>
    <VersionPrefix>0.11.4</VersionPrefix>
    <PackageProjectUrl>https://github.com/davewheatcroft3/Huddle</PackageProjectUrl>
    <RepositoryUrl>https://github.com/davewheatcroft3/Huddle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Mac Catalyst: the server, client and peer-to-peer packages now register the same Network framework services as iOS (device id, Bonjour broadcast and browsing, NWConnection messaging). Before, a Mac Catalyst app had none, so building a server threw for want of IDeviceInfoProvider and IBroadcastService. The Apple code moved from Platforms/iOS to Apple/, which both platforms compile.</PackageReleaseNotes>
    <PackageTags>dotnet;maui;networking;local-network;service-discovery;peer-to-peer</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
